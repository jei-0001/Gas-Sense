<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/GasSense.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="top">

        <!-- Alert Icon -->
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/shape_icon_bg"
            android:backgroundTint="@color/critical_red_dim">

            <ImageView
                android:id="@+id/ivAlertIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_warning_triangle"
                app:tint="@color/critical_red" />
        </FrameLayout>

        <!-- Content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <!-- Title + Badge Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvAlertTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Gas Leak Detected"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSeverity"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:text="CRITICAL"
                    android:textColor="@color/critical_red"
                    android:textSize="9sp"
                    app:chipBackgroundColor="@color/critical_red_dim"
                    app:chipStrokeColor="@color/critical_red"
                    app:chipStrokeWidth="1dp"
                    app:chipMinTouchTargetSize="0dp"
                    style="@style/Widget.Material3.Chip.Assist" />
            </LinearLayout>

            <!-- Description -->
            <TextView
                android:id="@+id/tvAlertDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gas concentration exceeded 25% LEL — critical threshold"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- Timestamp + AutoShutoff Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_clock"
                    app:tint="@color/text_hint" />

                <TextView
                    android:id="@+id/tvTimestamp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Today, 2:34 PM"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp"
                    android:layout_marginStart="4dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAutoShutoff"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:text="⚡ AutoShutoff"
                    android:textColor="@color/warning_yellow"
                    android:textSize="9sp"
                    app:chipBackgroundColor="@color/warning_yellow_dim"
                    app:chipMinTouchTargetSize="0dp"
                    android:visibility="gone"
                    style="@style/Widget.Material3.Chip.Assist" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
