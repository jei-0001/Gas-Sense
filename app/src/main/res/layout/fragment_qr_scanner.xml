<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Dark Overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_qr_overlay" />

    <!-- Top App Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#66000000"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/text_primary"
        app:title="@string/qr_title"
        app:titleTextColor="@color/text_primary"
        android:layout_gravity="top" />

    <!-- Scanning Frame + Helper -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_gravity="center">

        <!-- QR Frame -->
        <FrameLayout
            android:layout_width="240dp"
            android:layout_height="240dp">

            <!-- Corner brackets drawn via drawable -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_qr_frame"
                app:tint="@color/primary_navy_light" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/qr_helper"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="24dp"
            android:background="#66000000"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp" />
    </LinearLayout>

    <!-- Enter Manually link -->
    <TextView
        android:id="@+id/tvEnterManually"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/enter_id_manually"
        android:textColor="#4A90D9"
        android:textSize="14sp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="80dp"
        android:padding="12dp"
        android:minHeight="48dp"
        android:gravity="center" />

</FrameLayout>
